Algoritmo Dos_valores
    Definir valor_1, valor_2 Como Real
    
    Escribir 'Bienvenido a continuacion digitara dos valores'
    Escribir 'Digite el primer valor'
    Leer valor_1
    
    Escribir 'Digite el segundo valor'
    Leer valor_2
    
    Si valor_1 > valor_2 Entonces
        Escribir 'El valor mayor es: ', valor_1
        Escribir 'El valor menor es: ', valor_2
    SiNo
        Escribir 'El valor menor es: ', valor_1
        Escribir 'El valor mayor es: ', valor_2
    FinSi
FinAlgoritmo

