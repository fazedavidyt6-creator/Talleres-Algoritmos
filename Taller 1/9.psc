Algoritmo area_trapecio
	Definir base_menor, base_mayor, altura, area_trap Como Real
	Escribir "Digite la base menor del trapecio "
	leer Bme
	Escribir "Digite la base mayor del trapecio "
	leer Bma
	Escribir "Digite la altura del trapecio"
	leer H
	area_trap <- ((Bme+Bma)/2)*H
	Escribir "La base menor del trapecio es:", Bme
	Escribir "La base mayor del trapecio es:", Bma
	Escribir "La altura del trapecio es:", H
	Escribir "El area del trapecio es: ", area_trap
	
FinAlgoritmo
