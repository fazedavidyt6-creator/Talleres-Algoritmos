Algoritmo area_rombo
	Definir diagonal_menor, diagonal_mayor, area_romb Como Real
	Escribir "Digite el valor para la diagonal menor"
	leer Dme
	Escribir "Digite el valor para la diagonal mayor"
	leer Dma
	area_romb <- (Dme*Dma)/2
	Escribir "La diagonal menor digitada es: ", Dme
	Escribir "La diagonal mayor digitada es : ", Dma
	Escribir "El area del rombo es: ", area_romb
FinAlgoritmo
