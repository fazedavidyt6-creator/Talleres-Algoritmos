Algoritmo cuatro_valores
	Definir v1, v2, v3, v4, suma, resta Como Real
	Escribir "Digite el primer valor"
	leer v1
	Escribir "Digite el segundo valor"
	leer v2
	Escribir "Digite el tercer valor"
	leer v3
	Escribir "Digite el cuarto valor"
	leer v4
	suma <- (v1+v2+v3+v4)
	resta <- (suma - v4)
	Escribir "La suma de los valores es: ", suma
	Escribir "el resultado de la suma menos el ultimo valor es: ", resta
	
FinAlgoritmo
