Algoritmo temperatura_grados
	Definir grados_centigrados, grados_fahrenheit Como Real
	Escribir " Escriba la temperatura en grados centigrados"
	leer GC
	GF <- (GC*9/5)+32
	Escribir "la temperatura en grados centigrados es: ", GC "C"
	Escribir "la temperatura en grados fahrenheit es ", GF "F"
	
FinAlgoritmo
