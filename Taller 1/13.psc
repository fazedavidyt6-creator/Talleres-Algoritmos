Algoritmo valor_pesosColombianos
	Definir Peso_colombiano, Dolar, Euro, Conver_dolar, Conver_euro Como Real
	Escribir "Escriba el valor en pesos colombianos"
	leer Peso_colombiano
	Conver_dolar<- (3083)
	Conver_euro<- (3579)
	Dolar <- (Peso_colombiano/Conver_dolar)
	Euro <- (Peso_colombiano/Conver_euro)
	Escribir "El valor en pesos colombianos es:", Peso_colombiano
	Escribir "El valor convertido a dolares es: ", Dolar
	Escribir "El vlor convertido a euros es: ", Euro
FinAlgoritmo
