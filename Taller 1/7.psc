Algoritmo area_rectangulo
	Definir base, altura, area_rect Como Real
	Escribir "Digite la base del rectangulo" 
	leer b
	Escribir "Digite la altura del rectangulo"
	leer h
	area_rect <- b*h
	Escribir "La base digitada es: ", b
	Escribir "La altura digitada es: ", h
	Escribir "El area del rectangulo es: ", area_rect
FinAlgoritmo
