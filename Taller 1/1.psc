Algoritmo area_triangulo
	Definir base, altura, area_trian como real
	Escribir " Escriba la base del triangulo"
	leer b
	Escribir " Escriba la altura del triangulo"
	leer h
	area_trian <- (b*h)/2
	Escribir "La base del triangulo es: ", b
	Escribir "La altura del triangulo es: ", h
	Escribir "El area del triangulo es: ", area_trian
	
FinAlgoritmo
