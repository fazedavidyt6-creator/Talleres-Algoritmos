Algoritmo Suma_valores
	Definir valor1, valor2, valor3, suma Como Real
	Escribir "Escriba el primer valor"
	Leer valor1
	Escribir "Escriba el segundo valor"
	leer valor2
	Escribir "Escriba el tercer valor"
	Leer valor3
	suma <- (valor1+valor2+valor3)
	Escribir "La suma de los valores es: ", suma
FinAlgoritmo
